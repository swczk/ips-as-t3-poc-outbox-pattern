# PostgreSQL
POSTGRES_DB=poc_db
POSTGRES_USER=poc_user
POSTGRES_PASSWORD=poc_pass
DATABASE_URL=postgresql://poc_user:poc_pass@localhost:5432/poc_db

# Kafka
KAFKA_BROKERS=localhost:9094
KAFKA_NUM_PARTITIONS=3
KAFKA_LOG_RETENTION_HOURS=168

# Kafka UI
KAFKA_UI_CLUSTER_NAME=local

# Serviços
PEDIDOS_PORT=3000
PEDIDOS_EVENTS_TOPIC=pedidos.events

# Relay Worker
RELAY_POLL_INTERVAL_MS=1000
RELAY_MAX_TENTATIVAS=5
RELAY_BATCH_SIZE=50

# Consumer Service
CONSUMER_GROUP_ID=pedidos-consumer-group
KAFKA_RETRY_COUNT=5
